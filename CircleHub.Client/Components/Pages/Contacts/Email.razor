@page "/contacts/email/{contactId:int}"
@rendermode InteractiveWebAssembly
@attribute [Authorize]

@inject NavigationManager Nav
@inject IContactDTOService ContactService

<PageTitle>Circle Hub | Email Contact</PageTitle>

@if (_emailData is not null)
{
    <div class="container">
        <div class="card shadow-lg my-3">
            <div class="card-body">
                <EmailForm EmailData="_emailData" ReturnUrl="/contacts" ReturnText="Back to Contacts" OnSubmit="SendEmail" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int ContactId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ContactDTO? _contact;
    private UserInfo? _userInfo;
    private EmailData? _emailData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _userInfo = await UserInfoHelper.GetUserInfoAsync(AuthStateTask);

            _contact = await ContactService.GetContactByIdAsync(ContactId, _userInfo!.UserId);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }

        if (_contact is not null)
        {
            _emailData = new EmailData()
            {
                Recipients = [_contact.Email!],
                Subject = $"Message for {_contact.FullNameTag}",
                Body = string.Empty,
                ReplyToEmail = _userInfo!.Email,
            };
        }
        else
        {
            ToastNavigationHelper.NavigateWithToast(Nav, "/contacts", "Something went wrong while loading the contact.", "danger");
        }
    }

    private async Task SendEmail(EmailData formEmailData)
    {
        Dictionary<string, object?> toastQueryParams = new();

        try
        {
            bool success = await ContactService.EmailContactAsync(
                ContactId,
                formEmailData,
                _userInfo!.UserId);

            if (success)
            {
                ToastNavigationHelper.NavigateWithToast(Nav, "/contacts", "Email sent successfully!", "success");
            }
            else
            {
                ToastNavigationHelper.NavigateWithToast(Nav, "/contacts", "Something went wrong while sending the email.", "danger");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ToastNavigationHelper.NavigateWithToast(Nav, "/contacts", "Something went wrong while sending the email.", "danger");
        }
    }
}
