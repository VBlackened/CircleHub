@page "/contacts/edit/{contactId:int}"
@attribute [Authorize]
@rendermode InteractiveWebAssembly

@inject IContactDTOService ContactService
@inject NavigationManager Nav

<PageTitle>CircleHub | @(contact?.FullNameTag ?? "Loading...")</PageTitle>

@if (contact is not null)
{
    <div class="container">
        <div class="p-3 my-5 border border-2 shadow-lg bg-light">
            <ContactForm Contact="contact" OnSubmit="HandleSubmit" />
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public int ContactId { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState>? AuthStateTask { get; set; }

    public UserInfo? userInfo;
    public ContactDTO? contact;

    protected override async Task OnInitializedAsync()
    {
        userInfo = await UserInfoHelper.GetUserInfoAsync(AuthStateTask);

        contact = await ContactService.GetContactByIdAsync(ContactId, userInfo!.UserId);

        if (contact is null)
        {
            ToastNavigationHelper.NavigateWithToast(Nav, "/contacts", "Something went wrong while loading the contact.", "danger");
        }
    }

    private async Task HandleSubmit(ContactDTO contact)
    {
        if (userInfo is not null)
        {
            try
            {
                await ContactService.UpdateContactAsync(contact, userInfo.UserId);

                ToastNavigationHelper.NavigateWithToast(Nav, "/contacts", "Contact successfully updated.", "success");
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex);
                ToastNavigationHelper.NavigateWithToast(Nav, "/contacts", "Something went wrong while updating the contact.", "danger");
            }
        }
    }
}