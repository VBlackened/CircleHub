@page "/categories/email/{categoryId:int}"
@rendermode InteractiveWebAssembly
@attribute [Authorize]

@inject NavigationManager Nav
@inject ICategoryDTOService CategoryService

<PageTitle>Circle Hub | Email Category</PageTitle>

@if (_emailData is not null)
{
    <div class="container">
        <div class="card shadow-lg my-3">
            <div class="card-body">
                <EmailForm EmailData="_emailData" ReturnUrl="/categories" ReturnText="Back to Categories" OnSubmit="SendEmail" />
            </div>
        </div>
    </div>
}

@code {

    [Parameter]
    public int CategoryId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private CategoryDTO? _category;
    private UserInfo? _userInfo;
    private EmailData? _emailData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _userInfo = await UserInfoHelper.GetUserInfoAsync(AuthStateTask);

            _category = await CategoryService.GetCategoryAsync(CategoryId, _userInfo!.UserId);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }

        if (_category is not null)
        {
            _emailData = new EmailData()
            {
                Recipients = _category.Contacts.Select(c => c.Email!).ToList(),
                Subject = $"Group message for {_category.Name}",
                Body = string.Empty,
                ReplyToEmail = _userInfo!.Email,
            };
        }
        else
        {
            Nav.NavigateTo("/categories");
        }
    }

    private async Task SendEmail(EmailData formEmailData)
    {
        string message = "Something went wrong while sending the email. Please try again later.";

        try
        {
            bool success = await CategoryService.EmailCategoryAsync(
                CategoryId,
                formEmailData,
                _userInfo!.UserId);

            if (success)
            {
                message = "Email sent successfully!";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }

        Nav.NavigateTo($"/categories?message={message}");
    }
}
