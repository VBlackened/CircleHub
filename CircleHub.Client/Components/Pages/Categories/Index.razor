@page "/categories"
@attribute [Authorize]
@rendermode InteractiveWebAssembly

@inject NavigationManager Nav

@inject ICategoryDTOService CategoryService

<PageTitle>CircleHub | Categories</PageTitle>

<div class="container">
    <EditForm Model="_newCategory" OnValidSubmit="HandleNewCategory">
        <DataAnnotationsValidator />

        <ul class="list-group my-3">
            <li class="list-group-item">
                <label for="CategoryName" class="form-label">Add a Category</label>
                <div class="d-flex gap-3">
                    <InputText @bind-Value="_newCategory.Name" class="form-control" placeholder="Category Name" />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy"></i>
                    </button>
                </div>
            </li>
        </ul>
    </EditForm>
    @if (!string.IsNullOrEmpty(_toastMessage))
    {
        <ToastMessage @key="_messageId" Message="@_toastMessage" Color="@_messageColor" />
    }
    <CategoryAccordion Categories="_categories" OnCategoryChange="UpdateCategory" OnCategoryDelete="DeleteCategory" />
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? _authStateTask { get; set; }

    [SupplyParameterFromQuery]
    private string? Message { get; set; }

    [SupplyParameterFromQuery]
    private string? MessageType { get; set; }

    private UserInfo? _userInfo;

    private CategoryDTO _newCategory = new CategoryDTO();

    private IEnumerable<CategoryDTO> _categories = [];

    private string? _toastMessage;
    private string? _messageColor;
    private Guid _messageId = Guid.NewGuid(); //used to force the ToastMessage component to re-render when the same message is shown multiple times in a row

    protected override async Task OnInitializedAsync()
    {
        _userInfo = await UserInfoHelper.GetUserInfoAsync(_authStateTask);
        _categories = await CategoryService.GetCategoriesAsync(_userInfo!.UserId);
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Message)) 
        {
            ShowToastMessage(Message, MessageType ?? "success");

            Dictionary<string, object?> queryParams = new()
            {
                { "message", null },
                { "messageType", null }
            };
            var uri = Nav.GetUriWithQueryParameters(queryParams);
            Nav.NavigateTo(uri, replace: true);
        }
    }

    private async Task HandleNewCategory()
    {
        await CategoryService.CreateCategoryAsync(_newCategory, _userInfo!.UserId);
        _newCategory = new CategoryDTO();

        _categories = await CategoryService.GetCategoriesAsync(_userInfo!.UserId);
        ShowToastMessage("Category created successfully!", "success");
    }

    private async Task UpdateCategory(CategoryDTO category)
    {
        await CategoryService.UpdateCategoryAsync(category, _userInfo!.UserId);
        ShowToastMessage("Category updated successfully!", "success");
    }

    private async Task DeleteCategory(int categoryId)
    {
        await CategoryService.DeleteCategoryAsync(categoryId, _userInfo!.UserId);
        _categories = await CategoryService.GetCategoriesAsync(_userInfo!.UserId);
        ShowToastMessage("Category deleted successfully!", "success");
    }

    private void ShowToastMessage(string message, string color)
    {
        _toastMessage = message;
        _messageColor = color;
        _messageId = Guid.NewGuid();
    }
}
